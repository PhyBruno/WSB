PORT=3000
DATABASE_URL=postgres://usuario:senha@localhost:5432/whatsapp_bridge

# Limite de tamanho do body JSON nas rotas que recebem mídia em base64
# (/messages e o thumbnailUrl de /message/sendButtons), no formato do
# express.json: número + unidade, ex "20mb". As demais rotas aceitam até 256kb.
JSON_BODY_LIMIT=20mb
# Envios com corpo grande (mídia em base64) processados ao mesmo tempo nessas
# rotas: cada um custa ~2,5x o tamanho do corpo enquanto é lido e decodificado.
# Corpo até 256kb (texto) não conta. O excedente espera até
# MEDIA_UPLOAD_QUEUE_TIMEOUT_MS na fila, sem o corpo ser lido, e depois recebe
# 503 com Retry-After.
MEDIA_UPLOAD_CONCURRENCY=5
MEDIA_UPLOAD_QUEUE_TIMEOUT_MS=30000
# POST /chat/getBase64FromMediaMessage montando a resposta ao mesmo tempo
# (download + base64 + JSON, ~4x o arquivo). Mesma fila/503, com o mesmo
# MEDIA_UPLOAD_QUEUE_TIMEOUT_MS.
MEDIA_BASE64_CONCURRENCY=3

# Só usada pelo docker-compose (o serviço "postgres" usa isso pra criar o
# banco, e a bridge monta o DATABASE_URL sozinha a partir daqui — não precisa
# duplicar). Ignorada se você não estiver usando o compose.
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# Chave que a sua aplicação principal deve enviar no header x-api-key em toda
# chamada. Obrigatória — o servidor recusa subir sem ela. Gere algo forte, ex:
# openssl rand -hex 32
API_KEY=troque-por-uma-chave-forte

# Reconexão automática após queda de conexão (não se aplica a /disconnect
# solicitado manualmente via API, que nunca reconecta sozinho).
RECONNECT_MAX_ATTEMPTS=5
RECONNECT_DELAY_MS=30000

# Quanto tempo (ms) POST /sessions/:id/messages espera por uma confirmação
# real de status (via evento messages.update: server_ack/delivery_ack/error)
# antes de responder. sendMessage() sozinho só confirma que a mensagem foi
# repassada ao servidor do WhatsApp, não que foi entregue — essa espera é o
# que permite a API devolver o resultado real (ou o motivo de uma falha) na
# mesma resposta HTTP. 0 desativa a espera (responde sem confirmar nada).
MESSAGE_STATUS_TIMEOUT_MS=8000

# Se uma sessão ficar em "connecting" (sem virar qr/connected/error) por mais
# tempo que isso, a bridge força a desconexão sozinha — igual a um
# /disconnect manual, ou seja, SEM tentar reconectar em seguida. Cobre o caso
# de o handshake travar sem nunca dar erro (comum atrás de firewall
# restritivo). 0 desativa esse watchdog.
CONNECTING_TIMEOUT_MS=45000

# URL pública desta bridge, repassada no campo "server_url" dos webhooks
# (mesmo campo da Evolution API). Vazio = "server_url": null.
SERVER_URL=

# Webhooks: tempo máximo (ms) de cada POST pro receptor. Menor que os 30s da
# Evolution de propósito: um receptor lento segura uma vaga de concorrência
# até estourar esse tempo.
WEBHOOK_TIMEOUT_MS=10000
# Quantos POSTs de webhook podem estar em andamento ao mesmo tempo (todas as
# sessões somadas).
WEBHOOK_CONCURRENCY=10
# Teto por webhook, dentro do total acima: um receptor lento (ou fora do ar,
# esperando o timeout) não ocupa todas as vagas e não atrasa os webhooks das
# outras instâncias.
WEBHOOK_CONCURRENCY_PER_WEBHOOK=2
# Intervalo (ms) do polling de segurança da fila de entregas. O normal é a
# fila ser acordada na hora em que uma mensagem chega; o polling só cobre
# retentativas agendadas e entregas que sobraram de um restart.
WEBHOOK_POLL_INTERVAL_MS=1000

# Retentativa com backoff exponencial (atraso inicial dobrando a cada
# tentativa, com teto e ±20% de variação aleatória). Com os defaults abaixo
# (15 tentativas, 5s, teto de 5min) a janela total fica em ~45 minutos — o
# suficiente pra um receptor ficar 30 min fora do ar sem perder aviso. A
# Evolution usa 10 tentativas, o que dá só ~20 min.
WEBHOOK_RETRY_MAX_ATTEMPTS=15
WEBHOOK_RETRY_INITIAL_DELAY_MS=5000
WEBHOOK_RETRY_MAX_DELAY_MS=300000

# Mídia embutida em base64 (webhooks com "base64": true). Acima desse tamanho
# (bytes, 20MB) o aviso vai sem o arquivo e com "base64Error": "too_large".
WEBHOOK_MEDIA_MAX_BYTES=20971520
# Tempo máximo (ms) do download de uma mídia no WhatsApp. Estourou, o aviso
# vai com "base64Error": "download_failed".
WEBHOOK_MEDIA_TIMEOUT_MS=30000
# Teto de memória (bytes, 100MB) do cache de mídia baixada, que evita baixar
# o mesmo arquivo uma vez por webhook/retentativa.
WEBHOOK_MEDIA_CACHE_MAX_BYTES=104857600
# Entregas com mídia montando/enviando ao mesmo tempo (download + base64 +
# JSON + POST, ~5x o arquivo cada). As outras esperam a vez; entregas sem mídia
# não entram nessa fila.
WEBHOOK_MEDIA_CONCURRENCY=3

# Por quantos dias o histórico de entregas concluídas (entregues ou com falha
# definitiva) fica guardado antes da limpeza automática.
WEBHOOK_DELIVERY_RETENTION_DAYS=7

# Chave da cifra (AES-256-GCM) dos valores de cabeçalho dos webhooks no
# banco — são os tokens dos receptores. Vazio = chave derivada da API_KEY:
# funciona sem configurar nada, mas trocar a API_KEY deixa os cabeçalhos
# salvos ilegíveis (as entregas falham até eles serem cadastrados de novo).
# Defina uma chave própria (mínimo 16 caracteres) para poder trocar a API_KEY:
# openssl rand -hex 32
WEBHOOK_HEADERS_KEY=

# Apaga do histórico (wa_messages) as mensagens gravadas há mais de N dias,
# numa limpeza horária. 0 = guarda pra sempre (default).
MESSAGE_RETENTION_DAYS=0

# Logs internos do baileys (JSON do pino no stdout, com "session":"<id>").
# warn = erros de socket/keepalive/decrypt sem o volume do info. Pra investigar
# uma instância que cai com frequência, suba pra info ou debug por um tempo.
# Valores: fatal, error, warn, info, debug, trace, silent.
BAILEYS_LOG_LEVEL=warn

# Sincronização de histórico do WhatsApp ao parear (ver historySync.js).
# minimal (default): não baixa histórico de mensagens, só os pacotes pequenos
#   com mapeamentos LID→número e nomes de contato. O histórico recente era o
#   que estourava o heap logo depois de ler o QR.
# off: nada (o Baileys avisa de instabilidade com LIDs).
# recent: default do Baileys (comportamento antigo).
HISTORY_SYNC=minimal

# Dias de histórico de aberturas/quedas/logouts com o motivo
# (wa_connection_events, GET /sessions/:id/connection-events). Limpeza horária.
CONNECTION_EVENTS_RETENTION_DAYS=30

# Nome dos grupos (groupSubject nos webhooks e no histórico). Busca em
# memória, depois na tabela wa_groups, e só então pergunta ao WhatsApp
# (sock.groupMetadata), que limita consultas (rate-overlimit).
# Tempo que o nome fica em memória antes de reler wa_groups (6h). Renomear o
# grupo atualiza na hora pelo evento do Baileys; o TTL cobre outra réplica.
GROUP_METADATA_TTL_MS=21600000
# Grupo cuja consulta falhou (erro, timeout, rate-overlimit) não é consultado
# de novo por esse tempo (5 min); enquanto isso o nome sai null.
GROUP_METADATA_FAILURE_TTL_MS=300000
# Espera máxima da consulta ao WhatsApp. É também o máximo que a entrega de um
# webhook de grupo espera pelo nome antes de sair com groupSubject null.
GROUP_METADATA_TIMEOUT_MS=3000
# Limites por requisição do GET /sessions/:id/messages: consultas ao WhatsApp
# (grupos que não estão na memória nem em wa_groups) e tempo total de espera.
# O que passar disso sai com groupSubject null, e a resposta continua 200.
GROUP_METADATA_HISTORY_MAX_LOOKUPS=10
GROUP_METADATA_HISTORY_BUDGET_MS=5000

# Memória. O Node limita o heap por conta própria (uma fração do container);
# NODE_MAX_OLD_SPACE_MB fixa esse teto e vira --max-old-space-size no compose.
# Regra: ~75% do limite de memória do container (2048MB -> 1536), o resto fica
# pros Buffers fora do heap (mídia, criptografia).
NODE_MAX_OLD_SPACE_MB=1536
# A cada quantos ms sai a linha "memória: ..." no log (0 desativa).
MEMORY_LOG_INTERVAL_MS=60000
# Acima de MEMORY_WARN_RATIO do limite do heap do V8 OU da memória do container
# (RSS, lido do cgroup) a linha vira ALERTA, com os suspeitos, e passa a sair
# neste intervalo (mínimo 1000).
MEMORY_WARN_RATIO=0.7
MEMORY_ALERT_INTERVAL_MS=10000
